IMG_NAME="kalender"
PI_GEN_RELEASE="Kalender-Pi"
RELEASE=trixie

LOCALE_DEFAULT=de_DE.UTF-8
KEYBOARD_KEYMAP=de
KEYBOARD_LAYOUT="German"
TIMEZONE_DEFAULT="Europe/Berlin"

FIRST_USER_NAME=kalender
FIRST_USER_PASS=changeme
DISABLE_FIRST_BOOT_USER_RENAME=1

ENABLE_SSH=1
WPA_COUNTRY=DE

# Left at pi-gen's default (1, i.e. cloud-init stays enabled on trixie): the
# Raspberry Pi Imager uses cloud-init's user-data/network-config format
# unconditionally for "OS customisation" on trixie-based images, regardless
# of what's on our own image, so disabling cloud-init here doesn't avoid
# that format -- it just means nothing ever processes the files the Imager
# writes, silently making username/password/WLAN customisation inert. An
# earlier version of this config disabled cloud-init after live hardware
# testing showed unreliable WiFi and a broken home directory (wrong UID)
# following Imager customisation -- but that testing ran through a CI cache
# bug (see git history / GitHub Actions workflow) that independently
# corrupted file ownership across the whole image, which is a much better
# fit for those exact symptoms. Left enabled to test that theory and to
# match official Raspberry Pi OS images, which ship cloud-init and
# NetworkManager together without this conflict.
# ENABLE_CLOUD_INIT=0

export KIOSK_URL="https://calendar.google.com/calendar/u/0/r"

STAGE_LIST="stage0 stage1 stage2 stage-kalender"

DEPLOY_COMPRESSION=none
