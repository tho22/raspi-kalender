diff --git a/export-image/prerun.sh b/export-image/prerun.sh
index 9f1b496..e3e4a46 100755
--- a/export-image/prerun.sh
+++ b/export-image/prerun.sh
@@ -18,7 +18,13 @@ ALIGN="$((8 * 1024 * 1024))"
 # some overhead (since actual space usage is usually rounded up to the
 # filesystem block size) and gives some free space on the resulting
 # image.
-ROOT_MARGIN="$(echo "($ROOT_SIZE * 0.2 + 200 * 1024 * 1024) / 1" | bc)"
+#
+# Bumped from the upstream default (0.2 + 200MB) to 0.2 + 800MB: the
+# export-image apt upgrade step (02-set-sources) briefly needs room for
+# both the old and new Chromium package during unpack (~250-350MB peak),
+# which exceeded the default margin on this image and failed with
+# "No space left on device".
+ROOT_MARGIN="$(echo "($ROOT_SIZE * 0.2 + 800 * 1024 * 1024) / 1" | bc)"
 
 BOOT_PART_START=$((ALIGN))
 BOOT_PART_SIZE=$(((BOOT_SIZE + ALIGN - 1) / ALIGN * ALIGN))
diff --git a/stage0/00-configure-apt/files/raspbian.sources b/stage0/00-configure-apt/files/raspbian.sources
index 0000000..0000000 100644
--- a/stage0/00-configure-apt/files/raspbian.sources
+++ b/stage0/00-configure-apt/files/raspbian.sources
@@ -1,6 +1,6 @@
 Types: deb
-URIs: http://raspbian.raspberrypi.com/raspbian/
+URIs: http://mirror.netcologne.de/raspbian/raspbian/
 Architectures: armhf
 Suites: RELEASE
 Components: main contrib non-free rpi
 Signed-By: /usr/share/keyrings/raspbian-archive-keyring.gpg
diff --git a/stage0/prerun.sh b/stage0/prerun.sh
